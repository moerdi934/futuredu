# Example environment variables for CDN migration
# Copy the relevant sections to your .env file

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_SSL=false

# ============================================================
# CLOUDINARY CONFIGURATION (for CDN migration)
# ============================================================
# Get these from: https://cloudinary.com/console
# (Sign up for free tier: 25GB storage, 25GB bandwidth/month)

CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# ============================================================
# NOTES:
# ============================================================
# 1. Never commit these credentials to git
# 2. Add .env to .gitignore
# 3. Free tier limits:
#    - Storage: 25 GB
#    - Bandwidth: 25 GB/month
#    - Transformations: 25 credits/month
# ============================================================
